APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apg
DB_USERNAME=root
DB_PASSWORD=

# 审计 Hash Chain 的 HMAC 密钥(CLAUDE §58/§75):只放环境变量,绝不进库、不进 Git。
# 生产必须填一个强随机值(php -r "echo bin2hex(random_bytes(32));"),且一经设定不可更改
# ——改了以后旧审计行的 event_hash 全部对不上,audit:verify-chain 会整链报断。
# 本地留空时会从 APP_KEY 派生并打 warning 日志,仅供开发使用。
AUDIT_HMAC_SECRET=

# 市场定价密钥(CLAUDE §30/§66/§75,M3-D3):价格波动 = HMAC(本密钥, 资源|价格窗口) 派生的确定性伪随机。
# 服务器任何时刻按窗口号重算都得到同一个价(不需要 cron 落窗),而客户端拿不到密钥就预测不了下一窗的价。
# ⚠️ 泄露 = 玩家能提前知道全部未来价格 = 无风险套利,危害等同于直接送钱。
# 生产必须填强随机值(php -r "echo bin2hex(random_bytes(32));");改动会让全市场价格瞬间跳变(历史成交流水不受影响)。
# 本地留空时会从 APP_KEY 派生并打 warning;APP_KEY 也没有时价格退化为无波动(Fail Safe:宁可不波动,也不用公开可推导的密钥)。
MARKET_PRICE_SECRET=

# 事件掷点密钥(CLAUDE §30/§66/§75,M3-D4):随机事件的「要不要触发 / 抽中哪一条 / 损失多少」
# 全部由 HMAC(本密钥, 城市|资格窗口|标签) 派生 —— 同一城市同一窗口重算一百次都是同一个结果。
# 这正是 backlog §11.3 要求的「离线补算的随机数不能依赖 now() 作种子」:玩家反复上下线也刷不出新事件。
# ⚠️ 泄露 = 玩家能提前算出自己每个窗口会触发什么 = 可以挑时间上线刷正向事件。
# 与 MARKET_PRICE_SECRET 刻意分成两把独立密钥:一把泄露不会连带另一套系统全被预测。
# 生产必须填强随机值(php -r "echo bin2hex(random_bytes(32));");
# 本地留空时会从 APP_KEY 派生并打 warning,两者都没有时退回 CSPRNG(掷点仍随机,但不再可重算)。
EVENT_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# 生产环境(HTTPS)必须改为 true,否则 session cookie 会以明文 HTTP 传输
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
