# =============================================================================
# apg 环境变量模板(.env.example)
#
# 用法:复制成 .env 后按注释填值。**本文件只放键名与示例,永远不放真实密钥**
#      —— .env 已在 .gitignore 里,.env.example 会随仓库公开(CLAUDE §75)。
# 生产环境该怎么填:每个键上方的「生产」一行就是答案;完整部署步骤见 docs/deploy.md 第 3 步。
# 校验:php artisan release:check 会确认 .env 未被 git 跟踪、本文件无真实 APP_KEY。
# =============================================================================

APP_NAME=Laravel

# 生产必须 production。它同时决定三件事:
#   ① Artisan 破坏性命令(migrate 等)要加 --force;
#   ② routes/web.php 里的 /api/_ping 探针**不注册**;
#   ③ Laravel 各处的 isProduction() 分支(如 storage 路由的 403→404 降级)。
APP_ENV=local

# ⚠️ 生产必须 false。true = 报错页把 Stack Trace / 文件路径 / SQL 吐给玩家(CLAUDE §78 / SECURITY.md)。
APP_DEBUG=true

# 应用加密密钥(session/cookie/签名 URL 都用它)。生产在服务器上现生成,**不要复制开发环境的**:
#   php artisan key:generate
# 换掉它 = 所有已登录玩家的 session 与加密 cookie 立即失效(数据不受影响)。
# 本文件永远留空;写成 base64:... 的真实值会被 release:check 判红。
APP_KEY=

# 生产填 https://你的域名(必须 https,CLAUDE §74)。它决定框架生成的绝对 URL 与签名 URL 前缀。
APP_URL=http://localhost

# ⚠️ 生产保持 UTC,不要改成 Asia/Kuala_Lumpur。
# 全项目「存 UTC、算 UTC」,展示口径的时区换算是前端/报表层的事;
# 改这里会让 Time Delta 结算、事件窗口、审计时间戳与既有存档全部错位。
# tests/Feature/ConfigTest.php 会断言这一项恒为 UTC。
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# bcrypt 成本因子。生产保持 12(测试环境由 phpunit.xml 降到 4 提速,与本文件无关)。
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# 日志(CLAUDE §60 Security Log / §84 保留策略)
# 应用日志 storage/logs/laravel.log,安全日志独立在 storage/logs/security.log。
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
# 生产建议改成 daily:single 会让 laravel.log 无限增长,共享主机磁盘吃不消。
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 生产建议 warning(或 error)。留 debug 会把大量正常流程写进磁盘,既费空间也稀释真正的错误。
LOG_LEVEL=debug
# daily 通道保留天数(仅在 LOG_STACK=daily 时生效)
LOG_DAILY_DAYS=14
# 安全日志(security 通道)独立配置:级别与保留天数都比应用日志更宽松,
# 因为它记录的是登录失败 / 越权 / 限流 / 不变量失败这类需要回溯的低频事件
LOG_SECURITY_LEVEL=debug
LOG_SECURITY_DAYS=30

# -----------------------------------------------------------------------------
# 数据库(生产:MySQL 5.7 共享主机;本地:MariaDB 10.4)
# 字符集全程 utf8mb4 —— 库、表、列、连接四处必须一致,否则中文排序/比较会出怪事。
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apg
DB_USERNAME=root
DB_PASSWORD=
# 显式写出来而不是靠框架默认值:生产 cPanel 建库时若默认成了 utf8mb3/latin1,
# 这两行能保证连接层仍按 utf8mb4 协商,建表也走 utf8mb4(CLAUDE §46 / deploy.md 第 3 步)
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# =============================================================================
# 三把服务端密钥(CLAUDE §30 / §58 / §66 / §75)
#
# 生产**三把都必须显式配置**,一把都不能少。生成方式统一:
#     php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"     (64 位十六进制)
# 或  openssl rand -hex 32
#
# 三把都只从环境变量读:绝不进数据库、绝不进 Git、绝不下发给前端、绝不写进日志或审计。
# 上线后核对(只看有没有值,不打印值):
#     php -r '$e=parse_ini_file(".env"); foreach(["AUDIT_HMAC_SECRET","MARKET_PRICE_SECRET","EVENT_SECRET"] as $k){ printf("%-22s %s\n",$k, empty($e[$k])?"✗ 缺失":"✓ 已配置"); }'
# =============================================================================

# 审计 Hash Chain 的 HMAC 密钥(CLAUDE §58/§75):只放环境变量,绝不进库、不进 Git。
# 生产必须填一个强随机值,且**一经设定不可更改**
# ——改了以后旧审计行的 event_hash 全部对不上,audit:verify-chain 会整链报断。
# 本地留空时会从 APP_KEY 派生并打 warning 日志,仅供开发使用。
AUDIT_HMAC_SECRET=

# 市场定价密钥(CLAUDE §30/§66/§75,M3-D3):价格波动 = HMAC(本密钥, 资源|价格窗口) 派生的确定性伪随机。
# 服务器任何时刻按窗口号重算都得到同一个价(不需要 cron 落窗),而客户端拿不到密钥就预测不了下一窗的价。
# ⚠️ 泄露 = 玩家能提前知道全部未来价格 = 无风险套利,危害等同于直接送钱。
# 生产必须填强随机值;与审计密钥不同,这把**可以轮换**(只影响未来窗口的噪声,历史成交流水不受影响),
# 但改动会让全市场价格瞬间跳变,非必要不要动。
# 本地留空时会从 APP_KEY 派生并打 warning;APP_KEY 也没有时价格退化为无波动(Fail Safe:宁可不波动,也不用公开可推导的密钥)。
MARKET_PRICE_SECRET=

# 事件掷点密钥(CLAUDE §30/§66/§75,M3-D4):随机事件的「要不要触发 / 抽中哪一条 / 损失多少」
# 全部由 HMAC(本密钥, 城市|资格窗口|标签) 派生 —— 同一城市同一窗口重算一百次都是同一个结果。
# 这正是 backlog §11.3 要求的「离线补算的随机数不能依赖 now() 作种子」:玩家反复上下线也刷不出新事件。
# ⚠️ 泄露 = 玩家能提前算出自己每个窗口会触发什么 = 可以挑时间上线刷正向事件。
# 与 MARKET_PRICE_SECRET 刻意分成两把独立密钥:一把泄露不会连带另一套系统全被预测,也便于单独轮换。
# 生产必须填强随机值;同样**可以轮换**(只影响未来窗口的掷点,不影响任何历史事件实例)。
# 本地留空时会从 APP_KEY 派生并打 warning,两者都没有时退回 CSPRNG(掷点仍随机,但不再可重算)。
EVENT_SECRET=

# -----------------------------------------------------------------------------
# Session / Cookie(CLAUDE §43 / §74;认证走 Laravel Session + CSRF,不用 Token)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
# 分钟。120 = 两小时不活动后需要重新登录
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# 留 null = 只发给当前域名,不跨子域。除非确实要跨子域共享登录,否则不要填
SESSION_DOMAIN=null
# ⚠️ 生产(HTTPS)必须改为 true,否则 session cookie 会以明文 HTTP 传输。
# 注意:设为 true 后 cookie 只在 https 下发送 —— 本地 http 开发环境保持 false
SESSION_SECURE_COOKIE=false
# 生产保持 true:禁止 JS 读取 session cookie,XSS 也偷不走登录态
SESSION_HTTP_ONLY=true
# 生产保持 lax:同站导航带 cookie、跨站表单 POST 不带,是 CSRF 的第二道闸
#(第一道是 web 组的 VerifyCsrfToken)。前后端同源部署,无需放宽成 none
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# -----------------------------------------------------------------------------
# 以下几组是 Laravel 骨架自带的默认块,**本项目当前一项都没用到**(CLAUDE §39:
# 暂不需要 Redis / 队列 worker / 对象存储;邮件尚无发信场景)。
# 生产照抄即可,不需要去申请任何第三方账号或填真实凭据。
# 将来真要启用其中某项,再把对应真实值写进生产 .env —— 依然不要写回本文件。
# -----------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# 骨架残留:本项目前端是纯 ES Modules,**没有构建步骤**(CLAUDE §1),不跑 Vite
VITE_APP_NAME="${APP_NAME}"
